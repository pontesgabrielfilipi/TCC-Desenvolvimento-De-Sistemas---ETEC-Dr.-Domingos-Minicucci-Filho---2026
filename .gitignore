# =====================================================
# AGERP - .gitignore
# =====================================================

# === 1. VARIÁVEIS DE AMBIENTE ===
.env
.env.local
.env.*.local
.env.*
*.env
!/.env.example

# === 2. BACKEND - JAVA / MAVEN / SPRING BOOT ===
target/

*.class
/*.class
/*/*.class
*.jar
*.war
*.ear

# === 3. FRONTEND - REACT + VITE ===
node_modules
dist
dist-ssr
build/
*.local

# Logs (unificado)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === 4. IDEs E EDITORES ===
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.settings/
.classpath
.project

# Arquivos do Visual Studio / Windows
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# === 5. PYTHON / MÓDULO IA ===
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env/
*.pkl
services/python-ia/model/*.pkl

# === 6. DOCKER ===
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
!docker-compose.prod.yml

# === 7. TESTES E FERRAMENTAS ===
testcontainers.properties
.flattened-pom.xml
.m2repo/

# === 8. SISTEMA OPERACIONAL E ARQUIVOS GERAIS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.swp
*~
HELP.md
agerp-frontend/playwright-report/
agerp-frontend/test-results/
agerp-frontend/tests/e2e/.auth/
scripts/docker/.isolation-runs/
