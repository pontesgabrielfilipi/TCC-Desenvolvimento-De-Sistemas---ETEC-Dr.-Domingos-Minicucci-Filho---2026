# Copie para .env e substitua os placeholders. Nunca versione segredos reais.
# Para mudar de ambiente, use --env-file com arquivo privado correspondente.

# PostgreSQL: inicializacao inicial do volume; alteracoes nao rotacionam senhas existentes.
POSTGRES_USER=CHANGE_ME_DB_OWNER
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD
POSTGRES_DB=agdb
SPRING_DATASOURCE_USERNAME=CHANGE_ME_APP_USER
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD
SPRING_FLYWAY_USER=CHANGE_ME_DB_OWNER
SPRING_FLYWAY_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD

# URL para execucao local IDE e URL Docker sao diferentes.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/agdb
AGERP_DOCKER_DATASOURCE_URL=jdbc:postgresql://postgres:5432/agdb
SPRING_PROFILES_ACTIVE=prod

# Host publicado no computador; loopback evita exposicao acidental.
AGERP_BIND_ADDRESS=127.0.0.1
# Para acesso LAN, use 0.0.0.0 e adicione a URL LAN em AGERP_CORS_ORIGINS.
AGERP_FRONTEND_BIND_ADDRESS=127.0.0.1
HOST_POSTGRES_PORT=15432
HOST_FRONTEND_PORT=5173
HOST_APP_PORT=8080
HOST_API_PORT=8002

# Origem exata (scheme+host+porta, sem / final), separada por virgulas.
# Substitua o endereco exemplo pela URL HTTPS do seu tailnet/ambiente.
AGERP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-TAILNET-HOST.example.ts.net
# CIDRs/IPs apenas do peer do proxy realmente verificado; vazio = nenhum.
AGERP_TRUSTED_PROXIES=

# JWT: segredo forte gerado fora do repositorio, ao menos 32 caracteres.
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION=86400000
JWT_ISSUER=agerp
# false permite o acesso HTTP local; true exige HTTPS para cookie de autenticacao.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Strict
JWT_COOKIE_DOMAIN=
AGERP_DEVICE_COOKIE_DAYS=180

AGERP_SEED_ENABLED=false
AGERP_LOGIN_MAX_FAILURES=10
AGERP_LOGIN_WINDOW_SECONDS=300

# IA: endereco Docker backend->Python; bind e porta internos do Python.
AGERP_IA_URL=http://python-ia-api:8000
AGERP_PYTHON_BIND_ADDRESS=0.0.0.0
AGERP_PYTHON_INTERNAL_PORT=8000
APP_WORKERS=1
APP_RELOAD=false
MODEL_DIR=/app/model

# Exportacoes; tempo em milissegundos.
AGERP_EXPORT_CORE_THREADS=2
AGERP_EXPORT_MAX_THREADS=4
AGERP_EXPORT_QUEUE_CAPACITY=8
AGERP_EXPORT_TIMEOUT_MS=300000
AGERP_EXPORT_CONCURRENT_LIMIT=3

# Hikari: conexoes e tempo de aquisicao (milissegundos).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Timeouts Nginx com unidade (s, m); corpo maximo com unidade (m).
AGERP_NGINX_PROXY_READ_TIMEOUT=300s
AGERP_NGINX_PROXY_CONNECT_TIMEOUT=30s
AGERP_NGINX_CLIENT_MAX_BODY_SIZE=10m
# IP exato do socket host->Nginx observado nos logs do Nginx; nao use rede/CIDR.
AGERP_NGINX_TRUSTED_INGRESS_IP=CHANGE_ME_OBSERVED_DOCKER_INGRESS_IP

# Logging: nunca habilite debug SQL/bind em ambiente com dados sensiveis.
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_AGERP_AGERP=INFO

# O navegador usa caminhos relativos /api e NAO precisa de credenciais.
# VITE_* entra no JavaScript no BUILD, nao e configuracao runtime.
VITE_API_URL=/
AGERP_DEV_PROXY_TARGET=http://127.0.0.1:8080
AGERP_DEV_ALLOWED_HOSTS=YOUR-TAILNET-HOST.example.ts.net
AGERP_DEV_BIND_ADDRESS=0.0.0.0
AGERP_DEV_PORT=5173
