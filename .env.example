# ==================== BANCO DE DADOS ====================
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminerp
POSTGRES_DB=agdb

# ==================== PORTAS NO HOST ====================
HOST_POSTGRES_PORT=15432
HOST_FRONTEND_PORT=5173
HOST_APP_PORT=8080
HOST_API_PORT=8002

# ==================== SPRING BOOT ====================
SPRING_PROFILES_ACTIVE=dev
# O .env e usado pelos processos locais do VS Code. O Compose sobrescreve
# este valor internamente com o hostname do servico `postgres`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/agdb
SPRING_DATASOURCE_USERNAME=aguser
SPRING_DATASOURCE_PASSWORD=agpass
SPRING_FLYWAY_USER=admin
SPRING_FLYWAY_PASSWORD=adminerp

# Segredo apenas ilustrativo: substitua por valor aleatório com 32+ caracteres.
JWT_SECRET=change-me-use-a-random-secret-with-at-least-32-characters
JWT_EXPIRATION=86400000
# false somente em desenvolvimento HTTP; use true atrás de HTTPS.
JWT_COOKIE_SECURE=false
# Dados demonstrativos são opt-in e nunca devem ser habilitados em produção.
AGERP_SEED_ENABLED=false

# ==================== FRONTEND ====================
REACT_APPSOURCE_URL=http://localhost:8080
VITE_API_URL=/

# Lista separada por virgulas. Deixe vazia quando nao houver proxy reverso confiavel.
AGERP_TRUSTED_PROXIES=
