{
  "name": "TCC Agerp - Java 25 + Node + Python",
  "image": "mcr.microsoft.com/devcontainers/java:25-trixie",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "latest",
      "installYarn": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers-extra/features/maven-sdkman:1": {
      "version": "3.9.11"
    }
  },

  "postCreateCommand": "java --version && mvn --version && node --version && python --version",
  "remoteUser": "vscode"
}
