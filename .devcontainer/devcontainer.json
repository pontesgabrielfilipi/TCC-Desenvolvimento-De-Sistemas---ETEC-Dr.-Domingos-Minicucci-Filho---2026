{
  "name": "TCC Agerp - Java 25 + Node + Python",
  "image": "mcr.microsoft.com/devcontainers/java:25-trixie",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "latest",
      "installYarn": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "dockerDashComposeVersion": "v2"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y maven && java --version && mvn --version && node --version && python --version",

  "forwardPorts": [8080, 5173, 3000],
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/python/current/bin"
  }
}
